# PostgreSQL expuesto por docker-compose en la raíz del monorepo.
DATABASE_URL="postgresql://nexopos:nexopos_dev_password@localhost:5433/nexopos?schema=public"

API_PORT=3001
WEB_ORIGIN="http://localhost:3000"
JWT_ACCESS_SECRET="replace-with-a-long-random-value"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-value"

# Debe tener 12 o más caracteres. Solo se usa al crear datos iniciales.
SEED_ADMIN_PASSWORD="use-a-unique-development-password"
